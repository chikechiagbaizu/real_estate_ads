<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Form View -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold" string="Sold" type="object" class="btn-primary" />
                    <button name="action_cancel" string="Cancel" type="object"
                        class="btn-danger" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,received,accepted,sold" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            name="action_view_offers" type="object" icon="fa-handshake-o">
                            <field name="offer_count" string="Offers" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <field name="name" placeholder="Enter Property Name" widget="char_emojis" />
                        <field name="tag_ids" widget="many2many_tags"
                            placeholder="Select Property Tags" options="{'color_field':'color'}" />
                        <group>
                            <field name='type_id' />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_offer" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" widget="boolean_toggle" />
                                <field name="garden" widget="boolean_toggle" />
                                <field name="garden_area" invisible="garden == False"
                                    readonly="garden == True" />
                                <field name="garden_orientation" invisible="garden == False"
                                    widget="selection_badge" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name='offer_ids'>
                                <list editable="bottom" decoration-success="status == 'accepted'"
                                    decoration-danger="status == 'refused'">
                                    <field name="price" />
                                    <field name="property_id" />
                                    <field name="partner_id" />
                                    <field name="creation_date" />
                                    <field name="validity" />
                                    <field name="deadline" widget="remaining_days" />
                                    <field name="status" readonly="1" />
                                    <button name="action_accept_offer" string="Accept" type="object"
                                        icon="fa-check"
                                        groups="real_estate_ads.group_property_manager" />
                                    <button name="action_decline_offer" string="Decline"
                                        type="object" icon="fa-times"
                                        groups="real_estate_ads.group_property_manager" />
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="sales_id" widget="many2one_avatar_user" />
                                <field name="buyer_id" />
                                <field name="phone" widget="email" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type_id" />
                <field name="tag_ids" widget="many2many_tags" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="expected_price" />
                <field name="best_offer" />
                <field name="selling_price" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="type_id" />
                <field name="postcode" />
                <field name="buyer_id" />
                <filter string="Sold" name="sold_state" domain="[('state','=','sold')]" />
                <filter string="New" name="new_state" domain="[('state','=','new')]" />
                <filter string="Offer Received" name="offer_received_state"
                    domain="[('state','=','received')]" />
                <filter string="Offer Accepted" name="offer_accepted_state"
                    domain="[('state','=','accepted')]" />
                <filter string="Cancelled" name="cancelled_state"
                    domain="[('state','=','cancelled')]" />
                <separator />
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by':'state'}" />
                </group>
                <!-- <searchpanel>
                    <field name="state" icon="fa-filter" groupby="group_by_state" />
                </searchpanel> -->
            </search>
        </field>
    </record>

    <!-- Quick Create Kanban View -->
    <record id="quick_create_estate_property_form" model="ir.ui.view">
        <field name="name">quick.create.estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                </group>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">estate.property.kanban.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" on_create="quick_create"
                quick_create_view="real_estate_ads.quick_create_estate_property_form">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="tag_ids" widget="many2many_tags"
                                        options="{'color_field':'color'}" />
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="offer_count" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="estate_property_pivot_view" model="ir.ui.view">
        <field name="name">estate.property.pivot.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="name" type="row" />
                <field name="selling_price" type="measure" />
                <field name="expected_price" type="measure" />
                <field name="facades" type="measure" />
                <field name="bedrooms" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="estate_property_graph_view" model="ir.ui.view">
        <field name="name">estate.property.graph.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="name" type="row" />
                <field name="selling_price" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="estate_property_calendar_view" model="ir.ui.view">
        <field name="name">estate.property.calendar.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <calendar date_start="date_availability" string="Properties" mode="month"
                event_open_popup="true">
                <field name="name" />
                <field name="date_availability" />
                <field name="postcode" />
            </calendar>
        </field>
    </record>
</odoo>